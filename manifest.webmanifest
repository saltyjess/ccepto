{
  "name": "Crowders Creek PTO",
  "short_name": "CCE PTO",
  "description": "Crowders Creek Elementary PTO — events, volunteer sign-ups, calendars, news, and how to reach us.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fdfcfa",
  "theme_color": "#fdfcfa",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://ccepto.org/manifest.webmanifest"
    }
  ]
}
